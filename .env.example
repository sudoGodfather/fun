# --- Database ---
# Any Postgres works: Supabase, Neon, Railway, RDS, local docker, etc.
DATABASE_URL="postgresql://user:password@host:5432/hackathon_tracker"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- GitHub OAuth ---
# https://github.com/settings/developers
# Authorization callback URL: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Resend (email login links + deadline reminder emails) ---
# https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Hackathon Tracker <reminders@yourdomain.com>"

# --- Twilio (phone number OTP login) ---
# https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- Cron security ---
# Any random string. Sent as a Bearer token by the scheduler that hits /api/cron/reminders
CRON_SECRET=""
